APP_NAME=ThreatLens
APP_ENV=development
DATABASE_URL=postgresql:///threatlens

# Optional GitHub ingestion settings. If owner/repo are set, ThreatLens will
# fetch open Dependabot alerts from GitHub. Otherwise it falls back to mock data.
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional integrations. If left empty, ThreatLens simulates the actions.
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
